NODE_ENV=production
PORT=8787
DB_PATH=/data/computex.db
CORS_ORIGINS=https://compute.example.com
SESSION_TTL_MS=43200000
GUEST_SESSION_TTL_MS=1800000
GUEST_RATE_LIMIT_WINDOW_MS=600000
GUEST_RATE_LIMIT_MAX=20
SESSION_SECRET=replace-with-at-least-32-random-characters
SUPER_TEST_ENABLED=false
SUPER_TEST_ACCOUNT=replace-with-test-admin-account
SUPER_TEST_PASSWORD_HASH=replace-with-scrypt-password-hash
SUPER_TEST_SESSION_TTL_MS=1800000
